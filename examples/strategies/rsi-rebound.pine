//@version=5
strategy("RSI 超买超卖策略", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, slippage=1)

// ── 参数 ──
rsiLen    = input.int(14,    "RSI 周期", minval=2)
obLvl     = input.int(70,    "超买线", minval=50, maxval=95)
osLvl     = input.int(30,    "超卖线", minval=5, maxval=50)

// ── 计算 ──
rsiVal = ta.rsi(close, rsiLen)

// ── 入场条件：RSI 从超卖区上穿 ──
longCond  = ta.crossover(rsiVal, osLvl)
// ── 出场条件：RSI 从超买区下穿 ──
exitCond  = ta.crossunder(rsiVal, obLvl)

// ── 绘图 ──
// 副图 RSI 由系统内置指标统一渲染（companion 自动加载），此处不再重复 plot()

// ── 交易：基础多头模板，上穿超卖线买入、下穿超买线卖出 ──
if longCond
  strategy.entry("做多", strategy.long)

if exitCond
  strategy.close("做多")

// 买卖标记由回测引擎统一注入 B/S（实际成交，去重），脚本不再 plotshape 买卖信号
