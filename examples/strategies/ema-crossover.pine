//@version=5
strategy("均线交叉策略", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, slippage=1)

// ── 参数 ──
fastLen  = input.int(9,    "快线周期", minval=2)
slowLen  = input.int(21,   "慢线周期", minval=2)

// ── 计算 ──
fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)

// ── 信号 ──
longCond = ta.crossover(fastMA, slowMA)
exitCond = ta.crossunder(fastMA, slowMA)

// ── 绘图 ──
plot(fastMA, "快线", color.red,   linewidth=2)
plot(slowMA, "慢线", color.blue,  linewidth=2)
bgcolor(fastMA > slowMA ? color.new(color.red, 94) : color.new(color.green, 94))

// ── 交易：基础多头模板，金叉买入、死叉卖出 ──
if longCond
  strategy.entry("做多", strategy.long)

if exitCond
  strategy.close("做多")

// 买卖标记由回测引擎统一注入 B/S（实际成交，去重），脚本不再 plotshape 买卖信号
